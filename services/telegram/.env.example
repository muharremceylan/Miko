# Bu dosyaya gerçek değer yazma. Sunucuda python -m services.telegram.setup ile .env oluştur.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
BOT_PAIRING_CODE=
BOT_DATA_DIR=/data
BOT_ENABLE_OCR=1
BOT_MAX_FILE_MB=250
BOT_PART_MB=25
BOT_QUOTA_MB=2048
BOT_MAX_PAGES=1000
BOT_RETENTION_DAYS=7
BOT_JOB_TIMEOUT=1800
